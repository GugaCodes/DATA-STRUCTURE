void inserir(NoA** raiz, int v){
    NoA* novo = malloc(sizeof(NoA));
    if(novo == NULL) return;
    
    novo->valor = v;
    novo->right = NULL;
    novo->left = NULL;
    
    if((*raiz) == NULL)
    {
        (*raiz) = novo;
        return;
    }
    
    NoA* atual = *raiz;
    NoA* anterior = NULL;
    
    while(atual != NULL) {
        anterior = atual;
        if(v > atual->valor)
            atual = atual->right;
        else if(v < atual->valor)
            atual = atual->left;
    }
    
    if(v > anterior->valor)
        anterior->right = novo;
    else if(v < anterior->valor)
        anterior->left = novo;
}



int main()
{
    NoA* head = NULL;
    
    inserir(&head,10);
    inserir(&head,67);
    inserir(&head,5);
    inserir(&head,2);
    inserir(&head,6);
    
    printf("Raiz: %d, Esquerda %d, Direita %d\n", head->valor, head->left->valor, head->right->valor);
    printf("Raiz: %d, Esquerda %d, Direita %d", head->left->valor, head->left->left->valor, head->left->right->valor);
    
    return 0;
}
