


#include <stdio.h>
#include <stdlib.h>

typedef struct No {
    int valor;
    struct No* prox;
    struct No* ant;
}No;

void inserir_inicio(No** head, int v) {
    No* novo = malloc(sizeof(No));
    if (novo == NULL);
    novo->valor = v;
    novo->ant = NULL;
    novo->prox = *head;

    if (*head != NULL) {
        (*head)->ant = novo;
    }

    *head = novo;
}

void inserir_final(No** head, int v) {
    No* novo = malloc(sizeof(No));
    novo->valor = v;
    novo->prox = NULL;

    if (*head == NULL) {
        novo->ant = NULL;
        *head = novo;
    }
    else {
        No* p = *head;
        while (p->prox != NULL) {
            p = p->prox;
        }
        p->prox = novo; //Aqui o p é o ultimo da lista, portanto como queremos que o "novo" seja o ultimo, ó proximo depois de p sera o novo
        novo->ant = p; //O anterior do nosso novo no é o ultimo da lista
    }
}

void imprimir(No* head) {
    No* p = head;
    if (p == NULL) {
        printf("LISTA VAZIA");
    }
    printf("NULL");
    while (p != NULL) {
        printf("<- [%d] ->", p->valor);
        p = p->prox;
    }
    printf("NULL");
}

void imprimir_inverso(No* head){
    No * p = head;
    
    // percorrer até o final
    while (p->prox != NULL) {
        p = p->prox;
        
    }
    // inverter a impressao
    while (p != NULL) {
        printf("<- [%d] ->", p->valor);
        p = p->ant;
    }
    printf("NULL\n");
}








int main() {
    No* head = NULL;

    inserir_inicio(&head, 2);
    inserir_inicio(&head, 27);
    inserir_inicio(&head, 9);
    inserir_inicio(&head, 16);
    imprimir(head);
    printf("\n---------------Invertido------------\n");
    imprimir_inverso(head);
    printf("\n-----------Adicionando no final---------\n");
    inserir_final(&head, 13);
    imprimir(head);


}
