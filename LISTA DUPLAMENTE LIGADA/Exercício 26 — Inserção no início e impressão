


#include <stdio.h>
#include <stdlib.h>

typedef struct No {
    int valor;
    struct No* prox;
    struct No* ant;
}No;

void inserir_inicio(No** head, int v) {
    No* novo = malloc(sizeof(No));
    if (novo == NULL);
    novo->valor = v;
    novo->ant = NULL;
    novo->prox = *head;

    if (*head != NULL) {
        (*head)->ant = novo;
    }

    *head = novo;
}

void imprimir(No* head) {
    No* p = head;
    if (p == NULL) {
        printf("LISTA VAZIA");
    }
    printf("NULL");
    while (p != NULL) {
        printf("<- [%d] ->", p->valor);
        p = p->prox;
    }
    printf("NULL");
}




int main() {
    No* head = NULL;

    inserir_inicio(&head, 2);
    inserir_inicio(&head, 27);
    inserir_inicio(&head, 9);
    inserir_inicio(&head, 16);
    imprimir(head);

}
