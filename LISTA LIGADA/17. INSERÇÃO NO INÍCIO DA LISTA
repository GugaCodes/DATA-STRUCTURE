

#include <stdio.h>
#include <stdlib.h>
//#include <iostream>

typedef struct No {
    int valor;
    struct No* prox;
}No;

void insercao_inicio(No** head, int v) {
    No* novoElemento = malloc(sizeof(No));
    if (novoElemento == NULL) return;
    novoElemento->valor = v;
    novoElemento->prox = *head;
    *head = novoElemento;

}

void imprimir(No* head) {
    No* p = head;
    while (p != NULL) {
        printf("[%d] ->", p->valor);
        p = p->prox;
    }
}




int main()
{
    No* head = NULL;
    insercao_inicio(&head, 10);
    insercao_inicio(&head, 20);
    insercao_inicio(&head, 30);

    imprimir(head);
    
    
}


