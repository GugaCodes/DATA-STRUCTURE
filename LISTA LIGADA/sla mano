void imprimir(No* head) {
	No* p = head;

	while (p != NULL) {
		printf("[%d] -> ", p->valor);
	}
	printf("NULL\n");
}

void inserir_inicio(No** head, int v) {
	No* novo = malloc(sizeof(No));
	if (novo == NULL) return;

	novo->valor = v;
	novo->prox = *head;
	*head = novo;

}

void inserir_final(No** head, int v) {
	No* novo = malloc(sizeof(No));
	if (novo == NULL)return;

	novo->valor = v;
	novo->prox = NULL;

	if (*head == NULL){
		*head = novo;
		return;
	}

	No* p = *head;

	while (p->prox != NULL) {
		p = p->prox;
	}
	p->prox = novo;
}

void inserir_ordenado(No** head, int v) {
	No* novo = malloc(sizeof(No));
	if (novo == NULL) return;
	novo->valor = v;

	if (*head == NULL || v <= (*head)->valor) {
		novo->prox = *head;
		*head = novo;
	}

	No* anterior = *head;
	No* atual = (*head)->prox;

	while (atual != NULL && atual-> valor < v) {
		anterior = atual;
		atual = atual->prox;
	}
	anterior->prox = novo;
	novo->prox = atual;
}
























