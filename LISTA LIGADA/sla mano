void remover(No** head, int v) {
	if (*head == NULL) return;

	if ((*head->valor == v)) {
		No* temp = *head;
		*head = *head->prox;
		free(temp);
		return;
	}

	No* anterior = *head;
	No* atual = (*head)->prox;

	while (atual != NULL) {
		if (atual->valor == v) {
			anterior->prox = atual->prox;
			free(atual);
			return;
		}
		anterior = atual;
		atual = atual->prox;
	}
}









