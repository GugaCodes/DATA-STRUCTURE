void inserir_ordenado(No** head, int v) {

	No* novo = malloc(sizeof(No));
	if (novo == NULL) return;
	novo->valor = v;

	if (*head == NULL || v <= (*head)->valor) {
		novo->prox = *head;
		*head = novo;
	}

	No* anterior = *head;
	No* atual = (*head)->prox;

	while (atual != NULL && atual->valor < v) {
		anterior = atual;
		atual = atual->prox;
	}
	anterior->prox = atual->prox;
	novo->prox = atual;
}

int contar(No* head) {
	int cont = 0;
	No* p = head;

	while (p != NULL) {
		cont++;
		p = p->prox;
	}
	return cont;
}

No* busca(No* head, int v) {
	No* p = head;

	while (p!= NULL) {
		if (p->valor == v) {
			return p;
		}
		p = p->prox;
	}
	return NULL;
}

void buscar(No* head, int v) {
	int resultado = busca(head, v);

	if(resultado != NULL){
		printf("Valor %d encontrado", v);
	}
	else {
		printf("Valor nao encontrado\n\n");
	}
}

