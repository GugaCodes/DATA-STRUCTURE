typedef struct No {
    int valor;
    struct No* prox;
}No;

void insercao_inicio(No** head, int v) {
    No* novoElemento = malloc(sizeof(No));
    if (novoElemento == NULL) return;
    novoElemento->valor = v;
    novoElemento->prox = *head;
    *head = novoElemento;

}

void inserir_final(No** head, int v) {

    No* novoFim = malloc(sizeof(No*));
    if (novoFim == NULL) return;

    novoFim->valor = v;
    novoFim->prox = NULL;

    if (*head == NULL) {
        *head = novoFim;
        return;
    }

    No* p = *head;
    while (p->prox != NULL) {
        p = p->prox;
    }

    p->prox = novoFim;
}

void inserir_ordenado(No** head, int v) {
    No* novoOrdenado = malloc(sizeof(No));
    if (novoOrdenado == NULL) return;
    novoOrdenado->valor = v;

    //CASO ESPECIAL
    if (*head == NULL || novoOrdenado < *head) {
        novoOrdenado->prox = *head;
        *head = novoOrdenado;
        return;
    }


    //CASO GERAL: PERCORRER COM 2 PONTEIROS
    No* anterior = *head;
    No* atual = (*head)->prox;


    while (atual != NULL && atual->valor < v) {
        anterior = atual;
        atual = atual->prox;
    }

    anterior->prox = novoOrdenado;
    novoOrdenado->prox = atual;



}

void imprimir(No* head) {
    No* p = head;
    if (p == NULL) printf("LISTA VAZIA ");

    while (p != NULL) {
        printf("[%d] -> ", p->valor);
        p = p->prox;
    }
    
    printf("NULL\n");
}

int buscar(No* head, int v) {
    No* atual = head;
    while (atual != NULL) {
        if (atual->valor == v) {
            return atual;
        }
        atual = atual->prox;
    }
    return NULL;
}

