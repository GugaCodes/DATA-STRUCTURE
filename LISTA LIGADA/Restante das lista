void remover_por_valor(No **head, int v) {

    //CASO 1
    if (*head == NULL || (*head)->valor == v) {
        No* temp = *head; // GUARDAMOS O VAOR DE HEAD EM UMA VARIAVEL TEMPORARIA
        *head = (*head)->prox; // HEAD COMEÇA APONTAR PARA O PROXIMO
        free(temp); // FREE NA VARIAVEL TEMPORARIA
        return;
    }
    No* atual = (*head)->prox;
    No* anterior = *head;

    while (atual != NULL) {
        if (atual->valor == v) // se o atual for igual ao valor
        {
            anterior->prox = atual->prox; // anterior recebe o proximo nó do que vamos remover, ou seja, o atual
            free(atual);// libera o atuao
            return;
        }
        anterior = atual;
        atual = atual->prox;
    }
    
}

void zerar_lista(No **head)
{
    No* atual = (*head); // Definimos um no atual como o no apontado pelo head, ou seja, ATUAL = 10
    No* temp = NULL; // Definimos um no temporario para ser usado no futuro, começa valendo nulo

    while(atual != NULL) //Enquanto a lista não acabar roda esse loop
    {
        temp = atual; // O no temporario começa a valer a mesma coisa que o atual, ou seja, 10
        atual = atual->prox; //Atual vai começar a apontar pro proximo, ou seja, 20
        free(temp); // Liberamos o 10
    } // Continua as iterações até limpar tudo

    (*head) = NULL; //Faz a cabeça apontar para nulo
}

void reordenar(No* head) {
    if (head == NULL) return;

    for(No* i = head; i->prox != NULL; i = i->prox) // index i começa no No que head aponta, o loop vai rodar até o ultimo no, ou seja, quando o no atual apontar para nulo
    {   
        No* menor = i; // definimos o no menor como o primeiro no do loop, o que i está apontando 
        for(No* j = i->prox; j != NULL; j = j->prox) // index j começa no No depois do que i esta apontando, enquanto ele não valer nulo, vai andando
        {
            if (j->valor < menor->valor) // se o valor apontado por j for menor que o valor do nó menor
            {
                menor = j; //fazemos o no menor virar o no apontado por j
            }
        }

        if(menor != i) // se o menor for diferente do primeiro do loop
        {
            int temp = i->valor; // faz um temp pra guardar o valor do primeiro do loop
            i->valor = menor->valor; // faz o valor do primeiro no do loop receber o valor do no menor
            menor->valor = temp; // valor do no menor recebe o temp
        }
        imprimir(head);
    }
}

int contar(No* head) {
    int contar = 0;
    while (head != NULL) {
        contar++;
        head = head->prox;
    }
    return contar;
}

void remover_ultimo(No* head) {
    if (head == NULL) return;

    if (head->prox == NULL) { // se o proximo valor depois do head for igual a null
        free(head); // remove o único valor que tinha na lista
        head = NULL; // head aponta para nulo, pois não há valores
    }

    No* atual = head; // no atual recebe o primeiro valor

    while(atual->prox->prox != NULL) // se o proximo do proximo valor for diferente de nulo
    {
        atual = atual->prox; //valor atual percorre para próximo valor 
    }

    free(atual->prox); // remove o proximo valor 
    atual->prox = NULL; // deixa o valor anterior ao que foi removido apontando para NULL
}
